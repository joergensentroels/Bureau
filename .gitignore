# OS cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp

# Runtime state & generated output — kept out of the repo so your company's
# data (org config, deliverables, generated agent bios) isn't published.
# A fresh clone boots with an empty org from the app's built-in defaults.
data-bureau.json
data-foreman.json
data-*.backup-*.json
data-bureau-ws-*.json
data-bureau-workspaces.json
drafts/
drafts-*/
agent-profiles/
agent-profiles-*/

# Prototype / scratch pages
public/_*.html

# session backups + sqlite db
_backup-*/
data-bureau.db
data-bureau.db-*

# detached-server runtime logs (from launching `node server.mjs` in the background)
server.out.log
server.err.log

# eval harness: timestamped run reports (the committed baseline.json is the tracked reference)
eval/reports/

# Start-Bureau.ps1's detached-mode logs
bureau.log
bureau.log.err
