#!/bin/sh
# Bureau pre-push gate — runs the full offline test suite (pure + server, self-hosted) before every
# push and blocks it on any failure. This is what stops a change (e.g. the auth gate that 401'd the
# whole server suite) from being pushed untested.
#
# Enabled via:  git config core.hooksPath .githooks   (run once; already set in this clone)
# Emergency bypass (use sparingly):  git push --no-verify
#
# Git exports GIT_DIR and friends into every hook, and every child process inherits them. That is not
# merely noisy here: probe-doctor and finding-gate BUILD throwaway repositories, and they set a fixture
# identity with `git config`, use it, and restore it afterwards. With GIT_DIR inherited, every one of
# those commands retargets THIS repository instead — so the set-and-restore lands on the operator's real
# config, and a suite that crashes between the two never restores it.
#
# That is not hypothetical. It is what left `core.bare = true` in .git/config, which made every worktree
# refuse work-tree operations, which made `git push` impossible — so this gate stopped running, which is
# why nothing caught it. The suites pass standalone and fail only in here, which is the signature of an
# inherited environment rather than a broken test.
#
# Strip the lot before running anything. This hook shells out to no git of its own, so it needs none of them.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES GIT_COMMON_DIR
#
# Two gates, cheapest first. The coverage audit is TESTING.md's gate item 3 — "no new export/endpoint
# ships without a test or a ledger entry" — and it was not run here at all, so the rule held only as
# long as somebody remembered it. It takes well under a second, and failing on it before spending two
# minutes on the suite is the whole reason it goes first.
echo "pre-push: node test/coverage-audit.mjs"
node test/coverage-audit.mjs || {
  echo ""
  echo "✗ pre-push blocked: an export or route is neither referenced by a test nor listed in TESTING.md."
  echo "  Add a test, or add a ledger entry under 'Intentionally not auto-tested' saying why not."
  echo "  Bypass with 'git push --no-verify' (not recommended)."
  exit 1
}
echo "pre-push: node test/run-all.mjs --serve"
node test/run-all.mjs --serve || {
  echo ""
  echo "✗ pre-push blocked: tests failed. Fix them, or bypass with 'git push --no-verify' (not recommended)."
  exit 1
}

# WHAT DID THE LAST PUSH DO ON CI? Advisory, never blocking.
#
# This suite runs on Windows here and on ubuntu-latest there, and neither is a superset of the other. A
# test carrying a platform assumption passes the gate above and fails the runner -- which is exactly what
# happened: `closeSync(3)` guessed the log's descriptor, was right on Windows, wrong on Linux, and CI was
# red for TEN consecutive runs across three days on a public repository while every local push was green.
#
# Nothing here can prevent that. What it can do is make the next push the moment you find out, instead of
# whenever someone happens to open the Actions tab. Deliberately cannot block: no network, no gh, or an
# unauthenticated gh must never stand between the operator and a push.
if command -v gh >/dev/null 2>&1; then
  last=$(gh run list --limit 1 --branch main --json conclusion,displayTitle            --jq '.[0] | "\(.conclusion // "in progress")	\(.displayTitle[0:50])"' 2>/dev/null || true)
  case "$last" in
    failure*|cancelled*|timed_out*)
      echo ""
      echo "⚠ the PREVIOUS push is red on CI:  $last"
      echo "  Local runs on Windows, CI on ubuntu-latest. A green gate here does not mean green there."
      echo "  gh run view --log-failed" ;;
    success*) echo "pre-push: previous CI run passed" ;;
    *) : ;;   # in progress, unknown, or gh not authenticated — say nothing rather than guess
  esac
fi
